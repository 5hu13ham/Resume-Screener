# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Demo auth (works without Supabase for local MVP)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (optional when demo mode is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini via Google OpenAI-compatible API
# Copy this file to .env.local and set OPENAI_API_KEY locally.
# Never commit real keys.
OPENAI_API_KEY=
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-flash-latest

# Uploads
MAX_UPLOAD_BYTES=5242880
