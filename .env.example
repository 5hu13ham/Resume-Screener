# Portfolio demo, synthetic data only. Use a unique server-side secret.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true
# Generate a secret locally, e.g. openssl rand -hex 32; do not commit the real value
DEMO_SESSION_SECRET=

# Private account mode (optional, not required for the public demo):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Live Gemini (for private authenticated workflow only):
OPENAI_API_KEY=
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-flash-latest

# Private upload limits; public demo uploads are disabled.
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_FILES=10
